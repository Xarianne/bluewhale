# Terra (Fyra Labs) — https://terra.fyralabs.com/
# Needed for umbriel-nightly, xdg-desktop-portal-umbriel-nightly and
# noctalia-greeter, which are not packaged in Fedora proper.
[terra]
name=Terra $releasever
baseurl=https://repos.fyralabs.com/terra$releasever
type=rpm
skip_if_unavailable=True
gpgcheck=1
repo_gpgcheck=1
gpgkey=https://repos.fyralabs.com/terra$releasever/key.asc
enabled=1
enabled_metadata=1
metadata_expire=4h
