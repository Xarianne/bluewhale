// Inspired by Catnap (https://github.com/iinsertNameHere/catnap)
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "#C0C5CE"
        }
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {##F4B9B2} user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {##A8D8EA}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {##FCE38A}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ {##AA96DA}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {##95E1D3} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {##F7DC6F}󰌢 mb      {#keys}│",
            "type": "host"
        },
        {
            "key": "│ {##F4B9B2}󰇄 desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {##FCE38A}󰖲 comp    {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {##A8D8EA} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {##FCE38A} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {##AA96DA}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        // disk, memory and network disabled
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {##95E1D3} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
