[Unit]
Description=Devbox Automatic Update
Documentation=https://www.jetify.com/devbox/docs/
Wants=network-online.target
After=network-online.target
# devbox is not in the image (host-local install); skip when absent
ConditionPathExists=/usr/local/bin/devbox

[Service]
Type=oneshot
# skip metered connections (mirrors ublue's flatpak-update units)
ExecCondition=/bin/bash -c '[[ "$(busctl get-property org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager Metered | cut -c 3-)" == @(2|4) ]]'
ExecStart=/usr/local/bin/devbox -q version update
