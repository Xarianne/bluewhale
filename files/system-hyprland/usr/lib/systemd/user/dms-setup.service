# Deploy DMS's starter compositor config on a user's first login.
#
# This is a *user* unit: it runs under systemd --user, which only exists for
# logged-in users, so every user gets it automatically via the symlink
# etc/systemd/user/default.target.wants/dms-setup.service (presets are NOT
# re-applied to managers that already exist).
#
# 'dms setup' is blocked by default on immutable systems (dms's immutable
# policy), but this image ships /etc/dms/cli-policy.json setting
# immutable_system=false so the headless setup can run as the user.
#
# Guard: the truth about "is DMS configured" is the content of
# ~/.config/hypr/hyprland.lua. Hyprland's own autogenerated stub does NOT
# contain DMS's DMS_STARTUP_BEGIN marker; a real DMS deploy does. (Directory
# existence is a bad signal: DMS's runtime writes dms/*.lua fragments even
# when setup never ran.) When the marker is absent we run with --force,
# which overwrites the stub — timestamped backups land in
# ~/.config/hypr/.dms-backups first.
#
# To regenerate manually: dms setup headless --compositor hyprland \
#   --terminal ghostty --force

[Unit]
Description=Deploy DMS starter compositor config (first login only)
Documentation=https://danklinux.com/docs/dankmaterialshell/installation

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'grep -q "DMS_STARTUP_BEGIN" %h/.config/hypr/hyprland.lua 2>/dev/null || exec /usr/bin/dms setup headless --compositor hyprland --terminal ghostty --force'

# Ghostty on Linux ignores system-wide config (XDG_CONFIG_DIRS is not read;
# /etc/ghostty is macOS-only), and DMS's ghostty template has no `command`
# line and no include mechanism. So the image's default shell is appended
# to the user config right after DMS deploys it (idempotent via grep guard).
ExecStartPost=/bin/sh -c 'grep -q "^command =" %h/.config/ghostty/config 2>/dev/null || printf "\n# Default shell (shipped by the image; Ghostty ignores system-wide config)\ncommand = /usr/bin/fish\n" >> %h/.config/ghostty/config'

[Install]
WantedBy=default.target