# One-time DMS config deployment for a user on an atomic (ostree) system.
#
# 'dms setup' is blocked by default on immutable systems (dms's immutable
# policy), but this image ships /etc/dms/cli-policy.json setting
# immutable_system=false so the headless setup can run as the user.
#
# Runs once per user: the ConditionPathExists guard keys on the
# ~/.config/hypr/dms directory, which only a real DMS setup creates —
# Hyprland's own autogenerated stub (hyprland.lua without dms/) still
# counts as "not set up" and triggers deployment. Once the dms/ dir
# exists the unit stays skipped, across rebases too (home persists;
# this unit and the dms binary come from the new image).
# To regenerate manually: dms setup headless --compositor hyprland \
#   --terminal ghostty --force (backs up the old config first).
#
# Enable per user in the image recipe: dms-setup@<username>.service
# (the dms-setup-users generator does this automatically for every
# regular user, so no recipe edit is needed when users change).

[Unit]
Description=Deploy DMS starter compositor config for user %i (first login only)
Documentation=https://danklinux.com/docs/dankmaterialshell/installation
ConditionPathExists=!/var/home/%i/.config/hypr/dms

[Service]
Type=oneshot
User=%i
# --force: Hyprland's autogenerated stub lua makes the target path exist,
# so plain/skip-existing runs would refuse; --force overwrites it but
# creates a timestamped backup under ~/.config/hypr/.dms-backups first.
ExecStart=/usr/bin/dms setup headless --compositor hyprland --terminal ghostty --force

[Install]
WantedBy=multi-user.target